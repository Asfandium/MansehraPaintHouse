@model MansehraPaintHouse.Core.Entities.Product

@{
    ViewData["Title"] = Model.ProductID == 0 ? "Create Product" : "Edit Product";
}

<h2>@ViewData["Title"]</h2>

<!-- Page body -->
<div class="page-body">
    <div class="container-xl">
        <div class="card mb-5">
            <form asp-action="ProductUpsert" method="post" enctype="multipart/form-data" id="productForm">
                <input type="hidden" asp-for="ProductID" />
                <input type="hidden" asp-for="Image" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="UpdatedAt" />
                <input type="hidden" asp-for="CategoryID" id="CategoryID" value="@Model.CategoryID" />

                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryID" class="control-label">Category</label>
                    <select class="form-control" id="categoryDropdown">
                        <option value="">--Select Category--</option>
                        @if (ViewBag.Categories != null)
                        {
                            @foreach (var item in ViewBag.Categories)
                            {
                                @if (ViewBag.SelectedCategoryID != null && ViewBag.SelectedCategoryID.ToString() == item.Value)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryID" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="subcategoryDropdown" class="control-label">Subcategory</label>
                    <select id="subcategoryDropdown" class="form-control">
                        <option value="">Select Subcategory</option>
                        @if (ViewBag.Subcategories != null)
                        {
                            @foreach (var item in ViewBag.Subcategories)
                            {
                                @if (Model.CategoryID.ToString() == item.Value)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="control-label"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Image" class="control-label">Product Image</label>
                    <div class="input-group">
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <span class="input-group-text">Optional</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <div class="mt-2">
                            <p>Current image:</p>
                            <img src="@Model.Image" alt="Product Image" style="max-width: 200px;" class="img-thumbnail" />
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label asp-for="SKU" class="control-label"></label>
                    <input asp-for="SKU" class="form-control" />
                    <span asp-validation-for="SKU" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StockQuantity" class="control-label"></label>
                    <input asp-for="StockQuantity" class="form-control" type="number" />
                    <span asp-validation-for="StockQuantity" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MinimumStockLevel" class="control-label"></label>
                    <input asp-for="MinimumStockLevel" class="form-control" type="number" />
                    <span asp-validation-for="MinimumStockLevel" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Size" class="control-label"></label>
                    <input asp-for="Size" class="form-control" />
                    <span asp-validation-for="Size" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Color" class="control-label"></label>
                    <input asp-for="Color" class="form-control" />
                    <span asp-validation-for="Color" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ColorCode" class="control-label"></label>
                    <input asp-for="ColorCode" class="form-control" type="color" />
                    <span asp-validation-for="ColorCode" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" id="saveButton" class="btn btn-primary">Save</button>
                    <a asp-action="ProductIndex" class="btn btn-secondary">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Add bottom spacing -->
<div class="mb-1"></div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function () {
            console.log("Document ready");
            
            // Store the original category ID for comparison
            var originalCategoryId = $('#categoryDropdown').val();
            console.log("Original category ID: " + originalCategoryId);
            
            // Check if we're editing a product with a subcategory
            var productId = $('#ProductID').val();
            var isEditing = productId && productId !== "0";
            console.log("Is editing: " + isEditing + ", Product ID: " + productId);
            
            // Set the initial CategoryID value
            var initialCategoryId = $('#CategoryID').val();
            console.log("Initial CategoryID value: " + initialCategoryId);
            
            // If we have an initial CategoryID, make sure it's set correctly
            if (initialCategoryId && initialCategoryId !== "0") {
                // Check if it's a parent category
                var isParentCategory = false;
                $('#categoryDropdown option').each(function() {
                    if ($(this).val() === initialCategoryId) {
                        isParentCategory = true;
                    }
                });
                
                if (isParentCategory) {
                    // If it's a parent category, select it in the dropdown
                    $('#categoryDropdown').val(initialCategoryId);
                    console.log("Selected parent category: " + initialCategoryId);
                } else {
                    // If it's a subcategory, we need to find its parent and load the subcategories
                    // This will be handled by the category change event
                }
            }
            
            // Handle category dropdown change
            $('#categoryDropdown').change(function () {
                var categoryId = $(this).val();
                console.log("Category changed to: " + categoryId);
                
                // Clear the subcategory dropdown
                $('#subcategoryDropdown').empty().append('<option value="">Select Subcategory</option>');
                
                if (categoryId) {
                    // Fetch subcategories for the selected category
                    $.ajax({
                        url: '@Url.Action("GetSubcategories", "Product")',
                        type: 'GET',
                        data: { categoryId: categoryId },
                        success: function (data) {
                            console.log("Subcategories loaded: " + data.length);
                            // Add the subcategories to the dropdown
                            $.each(data, function (index, item) {
                                $('#subcategoryDropdown').append($('<option></option>')
                                    .attr('value', item.value)
                                    .text(item.text));
                            });
                            
                            // If we're editing and the product has a subcategory, select it
                            if (isEditing && '@Model.CategoryID' !== '0') {
                                var productCategoryId = '@Model.CategoryID';
                                console.log("Product Category ID: " + productCategoryId);
                                
                                // Check if the product's category is a subcategory of the selected category
                                var isSubcategory = false;
                                $('#subcategoryDropdown option').each(function() {
                                    if ($(this).val() === productCategoryId) {
                                        $(this).prop('selected', true);
                                        isSubcategory = true;
                                        console.log("Selected subcategory: " + productCategoryId);
                                    }
                                });
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Error loading subcategories: " + error);
                        }
                    });
                }
            });
            
            // If editing and the category has changed, trigger the change event
            if (originalCategoryId) {
                $('#categoryDropdown').trigger('change');
            }
            
            // If we have a validation error and the product has a category, make sure the subcategories are loaded
            if (isEditing && '@Model.CategoryID' !== '0') {
                // Check if the product's category is a parent category
                var isParentCategory = false;
                $('#categoryDropdown option').each(function() {
                    if ($(this).val() === '@Model.CategoryID') {
                        isParentCategory = true;
                    }
                });
                
                if (isParentCategory) {
                    // If it's a parent category, load its subcategories
                    $('#categoryDropdown').trigger('change');
                }
            }
            
            // Handle form submission
            $('#productForm').on('submit', function(e) {
                console.log("Form submit event triggered");
                
                // Get the subcategory ID
                var subcategoryId = $('#subcategoryDropdown').val();
                console.log("Subcategory ID: " + subcategoryId);
                
                // Get the category ID
                var categoryId = $('#categoryDropdown').val();
                console.log("Category ID: " + categoryId);
                
                // If a subcategory is selected, use its ID as the CategoryID
                if (subcategoryId) {
                    $('#CategoryID').val(subcategoryId);
                    console.log("Setting CategoryID to subcategory ID: " + subcategoryId);
                } else if (categoryId) {
                    // If no subcategory is selected, use the category ID
                    $('#CategoryID').val(categoryId);
                    console.log("Setting CategoryID to category ID: " + categoryId);
                } else {
                    // If neither is selected, prevent form submission
                    console.error("No category or subcategory selected");
                    e.preventDefault();
                    alert("Please select a category or subcategory");
                    return false;
                }
                
                // Log the final CategoryID value
                console.log("Final CategoryID value: " + $('#CategoryID').val());
                
                // Let the form submit normally
                return true;
            });
        });
    </script>
}
